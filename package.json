{
  "name": "kovahub",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev:backend": "pnpm --filter @kovahub/backend dev",
    "dev:frontend": "pnpm --filter @kovahub/frontend dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.vercel.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
