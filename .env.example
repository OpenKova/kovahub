KOVAHUB_API_HOST=0.0.0.0
KOVAHUB_API_PORT=8787
KOVAHUB_JWT_SECRET=change-me-in-development
KOVA_KOVAHUB_URL=http://localhost:8787
KOVAHUB_URL=http://localhost:8787
KOVAHUB_SITE=http://localhost:5173
KOVAHUB_REGISTRY=http://localhost:8787
KOVAHUB_ARCHIVE_STORAGE=local
KOVAHUB_ARCHIVE_DIR=.kovahub/archives
KOVAHUB_MAX_ARCHIVE_BYTES=26214400
KOVAHUB_MAX_ARCHIVE_ENTRIES=1000
KOVAHUB_MAX_EXTRACTED_BYTES=52428800
KOVAHUB_RATE_LIMIT_ENABLED=0
KOVAHUB_RATE_LIMIT_MAX=600
KOVAHUB_RATE_LIMIT_WINDOW_MS=60000
KOVAHUB_AUTH_RATE_LIMIT_MAX=60
KOVAHUB_AUTH_RATE_LIMIT_WINDOW_MS=600000
KOVAHUB_WRITE_RATE_LIMIT_MAX=60
KOVAHUB_WRITE_RATE_LIMIT_WINDOW_MS=3600000
KOVAHUB_METRICS_TOKEN=
KOVAHUB_BACKUP_RETENTION_DAYS=0
KOVAHUB_BACKUP_MAX_VERSIONS=0
KOVAHUB_BACKUP_INCLUDE_ARCHIVES=true
KOVAHUB_SITE_URL=http://localhost:5173
KOVAHUB_REGISTRY_URL=http://localhost:8787
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/v1/auth/github/callback
KOVAHUB_REVIEWER_HANDLES=

# Optional: when set, the backend uses Postgres instead of the in-memory repository.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kovahub
#
# Optional: S3/R2/Supabase-compatible archive storage for hosted Postgres mode.
# KOVAHUB_ARCHIVE_STORAGE=s3
# KOVAHUB_S3_ENDPOINT=https://example.r2.cloudflarestorage.com
# KOVAHUB_S3_BUCKET=kovahub
# KOVAHUB_S3_REGION=auto
# KOVAHUB_S3_ACCESS_KEY_ID=
# KOVAHUB_S3_SECRET_ACCESS_KEY=
# KOVAHUB_S3_PREFIX=archives
#
# Supabase Storage also works through its S3-compatible endpoint.
# KOVAHUB_ARCHIVE_STORAGE=supabase
# KOVAHUB_S3_ENDPOINT=https://project-ref.supabase.co/storage/v1/s3
# KOVAHUB_S3_BUCKET=kovahub-archives
# KOVAHUB_S3_REGION=your-supabase-region

VITE_KOVAHUB_API_URL=http://localhost:8787
