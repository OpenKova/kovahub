KOVAHUB_API_HOST=0.0.0.0
KOVAHUB_API_PORT=8787
KOVAHUB_JWT_SECRET=change-me-in-development
KOVAHUB_SITE_URL=http://localhost:5173
KOVAHUB_REGISTRY_URL=http://localhost:8787
KOVAHUB_ARCHIVE_DIR=.kovahub/archives
KOVAHUB_SEED_DATABASE=true

# Optional: when set, the backend uses Postgres instead of the in-memory repository.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kovahub

# Kova/OpenClaw-compatible overrides for local testing.
CLAWHUB_SITE=http://localhost:5173
CLAWHUB_REGISTRY=http://localhost:8787
OPENCLAW_CLAWHUB_URL=http://localhost:8787

VITE_KOVAHUB_API_URL=http://localhost:8787
